{
  "name": "kppproduksatu",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build --preset=node-server",
    "build:vercel": "nuxt build --preset=vercel",
    "build:cloudflare": "nuxt build --preset=cloudflare_module",
    "preview": "nuxt preview",
    "start": "node .output/server/index.mjs",
    "provision:super-accounts": "node scripts/provision-super-accounts.mjs",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deploy:staging": "npm run build:cloudflare && wrangler deploy"
  },
  "dependencies": {
    "@nuxt/ui": "^4.0.0",
    "@nuxtjs/supabase": "^2.0.0",
    "@supabase/supabase-js": "^2.0.0",
    "h3": "^1.15.0",
    "nuxt": "^4.0.0",
    "page-flip": "^2.0.7",
    "pdfjs-dist": "^6.4.299",
    "tailwindcss": "^4.0.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.9.0",
    "vue-tsc": "^3.0.0",
    "wrangler": "^4.0.0"
  }
}
