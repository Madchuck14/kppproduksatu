# Copy to .env. The default demo uses local fixtures; no Supabase account needed.
NUXT_CATALOG_SOURCE=demo
NUXT_PUBLIC_SITE_NAME="KPP Produk Satu"
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Populate both, then change NUXT_CATALOG_SOURCE to supabase.
# Use a public publishable/anon key, NEVER a service-role or secret key.
NUXT_PUBLIC_SUPABASE_URL=https://example.supabase.co
NUXT_PUBLIC_SUPABASE_KEY=demo-only-not-a-real-key

# Local administrative provisioning only. Never use a PUBLIC prefix for these values.
SUPABASE_SECRET_KEY=
SUPER_ACCOUNT_EDITOR_EMAIL=
SUPER_ACCOUNT_EDITOR_PASSWORD=
SUPER_ACCOUNT_SALES_EMAIL=
SUPER_ACCOUNT_SALES_PASSWORD=
